### Лабораторная работа №2 - DTO и JSON
### Запустите lab2/src/main/java/view/WebAppServer.java (порт 8080).
@host = http://localhost:8080

### Все новости (ответ - JSON-объект NewsListDTO)
GET {{host}}/reader/news/all

### Одна новость (ответ - JSON-объект NewsItemDTO)
GET {{host}}/reader/news/1

### Неверный id (400 + ActionStatusDTO)
GET {{host}}/reader/news/0

### Новости за последнюю неделю
GET {{host}}/reader/news/last_week

### Поиск по ключевым словам
GET {{host}}/reader/news/search?keywords=метро

### Поиск без параметра (400)
GET {{host}}/reader/news/search

### Новости региона
GET {{host}}/reader/news/region?region=Москва

### Категории (CategoryListDTO)
GET {{host}}/reader/categories

### Добавить в закладки (ActionStatusDTO)
POST {{host}}/reader/news/1/bookmark

### Оставить комментарий (CreateCommentRequestDTO -> CommentDTO)
POST {{host}}/reader/comments
Content-Type: application/json

{
  "newsId": 1,
  "author": "Иван",
  "text": "Очень полезная новость"
}

### Редактировать комментарий
PUT {{host}}/reader/comments/1
Content-Type: application/json

{
  "text": "Исправленный текст комментария"
}

### Удалить комментарий
DELETE {{host}}/reader/comments/1

### Создать новость (CreateNewsRequestDTO -> NewsItemDTO)
POST {{host}}/creator/news
Content-Type: application/json

{
  "title": "Новая новость",
  "annotation": "Краткое описание",
  "text": "Полный текст новости",
  "categoryId": 1,
  "author": "Редакция",
  "region": "Москва",
  "tags": ["новости", "город"]
}

### Изменить новость
PUT {{host}}/creator/news/1
Content-Type: application/json

{
  "title": "Обновлённый заголовок",
  "text": "Обновлённый текст"
}

### Удалить новость
DELETE {{host}}/creator/news/1

### Прикрепить медиафайл
POST {{host}}/creator/news/1/media?url=https://example.com/photo.jpg

### Добавить тег
POST {{host}}/creator/news/1/tags?tag=java

### Ответить на комментарий
POST {{host}}/creator/comments/1/reply
Content-Type: application/json

{
  "text": "Спасибо за отзыв!"
}

### ===== API администратора =====

### Список пользователей (UserListDTO)
GET {{host}}/admin/users

### Список ролей (RoleListDTO)
GET {{host}}/admin/roles

### Заблокировать пользователя (ActionStatusDTO)
POST {{host}}/admin/users/1/block

### Назначить роль (ActionStatusDTO)
PUT {{host}}/admin/users/1/role?role=ADMIN

### Модерировать комментарий (ActionStatusDTO)
POST {{host}}/admin/comments/1/moderate?action=approve
